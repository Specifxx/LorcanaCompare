{
  "name": "lorcanacompare",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && bash scripts/build-db-push.sh && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "test": "node --import tsx --test tests/*.test.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push --skip-generate",
    "import:all": "tsx scripts/import-all.ts",
    "alerts:send": "tsx scripts/send-alerts.ts",
    "ops:monitor": "tsx scripts/ops-monitor.ts",
    "indexnow": "tsx scripts/indexnow-submit.ts"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "@vercel/analytics": "^1.3.1",
    "bcryptjs": "^2.4.3",
    "jose": "^5.9.6",
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.35",
    "postcss": "^8.4.38",
    "prisma": "5.22.0",
    "tailwindcss": "^3.4.4",
    "tsx": "^4.16.0",
    "typescript": "^5.5.3"
  }
}
