# Copy to .env for local development. On Vercel set these under
# Project → Settings → Environment Variables; in GitHub under Settings →
# Secrets and variables → Actions.

# Neon Postgres (pooled URL). Private data only: accounts, alerts, clicks.
DATABASE_URL=
# Long random string for session cookies (openssl rand -hex 32)
AUTH_SECRET=
# Public site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=

# eBay Browse API (developer.ebay.com → Application Keys, Production)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# eBay Partner Network campaign id (shared with Rift Compare)
EBAY_AFFILIATE_CAMPAIGN=5339155912
# This site's share of the app's 5,000 daily Browse calls
EBAY_DAILY_BUDGET=2500

# TCGplayer affiliate (Impact) link
TCGPLAYER_IMPACT_LINK=https://partner.tcgplayer.com/c/7385758/1780961/21018
AMAZON_ASSOCIATE_TAG=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PLUS_MONTHLY=
STRIPE_PRICE_PLUS_YEARLY=
STRIPE_PRICE_PREMIUM_MONTHLY=
STRIPE_PRICE_PREMIUM_YEARLY=

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=

# AdSense (public id; the same publisher as Rift Compare)
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-6842128782879909
NEXT_PUBLIC_ADSENSE_SLOT_HOME=

# Search engines
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
INDEXNOW_KEY=

# eBay Marketplace Account Deletion endpoint token (32-80 chars, same on eBay)
EBAY_VERIFICATION_TOKEN=

# Cron / workflow shared secret
CRON_SECRET=
